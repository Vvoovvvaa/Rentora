<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Rentora Admin Password Changed</title>
</head>

<body style="
  margin:0;
  padding:0;
  background:#0a0f1a;
  font-family:Arial, Helvetica, sans-serif;
">

<table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
  <tr>
    <td align="center">

      <table width="560" cellpadding="0" cellspacing="0" style="
        background:#111827;
        border-radius:18px;
        overflow:hidden;
        border:1px solid #1f2937;
      ">

        <!-- TOP LINE -->
        <tr>
          <td style="
            height:5px;
            background:#22c55e;
          "></td>
        </tr>

        <!-- HEADER -->
        <tr>
          <td align="center" style="padding:35px 30px 15px;">

            <h1 style="
              margin:0;
              font-size:31px;
              font-weight:800;
              color:#ffffff;
            ">
              🛡️ Rentora Admin
            </h1>

            <p style="
              margin:10px 0 0;
              font-size:13px;
              color:#94a3b8;
              letter-spacing:0.5px;
            ">
              Administrative security notification
            </p>

          </td>
        </tr>

        <!-- SUCCESS ICON -->
        <tr>
          <td align="center" style="padding:20px;">

            <div style="
              width:90px;
              height:90px;
              background:#14532d;
              border:1px solid #166534;
              border-radius:50%;
              line-height:90px;
              font-size:40px;
              color:#22c55e;
            ">
              ✓
            </div>

          </td>
        </tr>

        <!-- CONTENT -->
        <tr>
          <td align="center" style="
            padding:15px 45px 25px;
          ">

            <h2 style="
              margin:0;
              font-size:24px;
              color:#ffffff;
            ">
              Password changed successfully
            </h2>

            <p style="
              margin-top:18px;
              font-size:15px;
              line-height:24px;
              color:#9ca3af;
            ">
              Hello, {{name}}.
              The password for your Rentora administrator account
              has been successfully changed.
            </p>

            <p style="
              margin-top:14px;
              font-size:14px;
              line-height:22px;
              color:#6b7280;
            ">
              You should now use your new password the next time
              you sign in to the Rentora administration panel.
            </p>

          </td>
        </tr>

        <!-- ACCOUNT DETAILS -->
        <tr>
          <td style="padding:10px 40px 20px;">

            <table width="100%" cellpadding="0" cellspacing="0" style="
              background:#1f2937;
              border-radius:12px;
              border:1px solid #374151;
            ">

              <tr>
                <td style="padding:22px;">

                  <p style="
                    margin:0;
                    font-size:12px;
                    color:#64748b;
                    letter-spacing:1px;
                  ">
                    ADMIN ACCOUNT
                  </p>

                  <p style="
                    margin:12px 0 0;
                    font-size:15px;
                    color:#ffffff;
                    font-weight:700;
                  ">
                    {{gmail}}
                  </p>

                  <p style="
                    margin:8px 0 0;
                    font-size:13px;
                    color:#9ca3af;
                  ">
                    Role: {{role}}
                  </p>

                  <p style="
                    margin:8px 0 0;
                    font-size:13px;
                    color:#9ca3af;
                  ">
                    Changed at: {{changedAt}}
                  </p>

                </td>
              </tr>

            </table>

          </td>
        </tr>

        <!-- SECURITY WARNING -->
        <tr>
          <td style="padding:10px 40px 25px;">

            <table width="100%" cellpadding="0" cellspacing="0" style="
              background:#3f1d1d;
              border:1px solid #7f1d1d;
              border-radius:12px;
            ">

              <tr>
                <td style="
                  padding:22px;
                  text-align:center;
                ">

                  <p style="
                    margin:0;
                    font-size:15px;
                    font-weight:700;
                    color:#fecaca;
                  ">
                    ⚠️ Didn't change your password?
                  </p>

                  <p style="
                    margin:10px 0 0;
                    font-size:13px;
                    line-height:20px;
                    color:#fca5a5;
                  ">
                    If you did not perform this action,
                    contact the Rentora super administrator immediately.
                    Your administrator account may be compromised.
                  </p>

                </td>
              </tr>

            </table>

          </td>
        </tr>

        <!-- SECURITY INFO -->
        <tr>
          <td style="padding:0 40px 30px;">

            <table width="100%" cellpadding="0" cellspacing="0" style="
              background:#172033;
              border-radius:12px;
            ">

              <tr>
                <td style="
                  padding:20px;
                  text-align:center;
                ">

                  <p style="
                    margin:0;
                    font-size:14px;
                    font-weight:700;
                    color:#e5e7eb;
                  ">
                    🔐 Security reminder
                  </p>

                  <p style="
                    margin:10px 0 0;
                    font-size:13px;
                    line-height:20px;
                    color:#9ca3af;
                  ">
                    Never share your administrator password or access token
                    with anyone. Rentora staff will never ask you
                    to send your password.
                  </p>

                </td>
              </tr>

            </table>

          </td>
        </tr>

        <!-- CONTACT -->
        <tr>
          <td align="center" style="
            padding:25px;
            border-top:1px solid #1f2937;
          ">

            <p style="
              margin:0 0 15px;
              font-size:12px;
              color:#64748b;
              letter-spacing:1px;
            ">
              SECURITY CONTACT
            </p>

            <a
              href="https://t.me/Vov_Markosyan"
              style="
                display:inline-block;
                margin:5px;
                padding:10px 18px;
                background:#229ED9;
                border-radius:10px;
                color:white;
                text-decoration:none;
                font-size:13px;
                font-weight:600;
              "
            >
              Telegram
            </a>

            <a
              href="https://www.instagram.com/vov_markosyann/"
              style="
                display:inline-block;
                margin:5px;
                padding:10px 18px;
                background:#E1306C;
                border-radius:10px;
                color:white;
                text-decoration:none;
                font-size:13px;
                font-weight:600;
              "
            >
              Instagram
            </a>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td align="center" style="
            padding:20px;
            background:#0f172a;
          ">

            <p style="
              margin:0;
              font-size:12px;
              color:#64748b;
            ">
              © {{year}} Rentora Administration
            </p>

            <p style="
              margin:8px 0 0;
              font-size:11px;
              color:#475569;
            ">
              Restricted administrative access
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>