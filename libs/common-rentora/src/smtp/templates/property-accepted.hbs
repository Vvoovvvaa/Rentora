<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Property Approved - Rentora</title>
</head>

<body style="
  margin:0;
  padding:0;
  background:#0a0f1a;
  font-family:Arial, Helvetica, sans-serif;
">

<table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
  <tr>
    <td align="center">

      <table width="560" cellpadding="0" cellspacing="0" style="
        background:#111827;
        border-radius:18px;
        overflow:hidden;
        border:1px solid #1f2937;
      ">

        <tr>
          <td style="
            height:5px;
            background:#22c55e;
          "></td>
        </tr>

        <tr>
          <td align="center" style="padding:35px 30px 15px;">

            <h1 style="
              margin:0;
              font-size:31px;
              font-weight:800;
              color:#ffffff;
            ">
              🏠 Rentora
            </h1>

            <p style="
              margin:10px 0 0;
              font-size:13px;
              color:#94a3b8;
            ">
              Property moderation notification
            </p>

          </td>
        </tr>

        <tr>
          <td align="center" style="padding:20px;">

            <div style="
              width:90px;
              height:90px;
              background:#14532d;
              border:1px solid #166534;
              border-radius:50%;
              line-height:90px;
              font-size:40px;
              color:#22c55e;
            ">
              ✓
            </div>

          </td>
        </tr>

        <tr>
          <td align="center" style="padding:15px 45px 25px;">

            <h2 style="
              margin:0;
              font-size:24px;
              color:#ffffff;
            ">
              Your property has been approved
            </h2>

            <p style="
              margin-top:20px;
              font-size:15px;
              line-height:24px;
              color:#9ca3af;
            ">
              Hello, {{name}}.
            </p>

            <p style="
              margin-top:10px;
              font-size:15px;
              line-height:24px;
              color:#9ca3af;
            ">
              Good news! Your property listing has successfully passed
              Rentora moderation and is now approved for publication.
            </p>

          </td>
        </tr>

        <tr>
          <td style="padding:10px 40px 20px;">

            <table width="100%" cellpadding="0" cellspacing="0" style="
              background:#1f2937;
              border-radius:12px;
              border:1px solid #374151;
            ">

              <tr>
                <td style="padding:22px;">

                  <p style="
                    margin:0;
                    font-size:12px;
                    color:#64748b;
                    letter-spacing:1px;
                  ">
                    PROPERTY DETAILS
                  </p>

                  <p style="
                    margin:14px 0 0;
                    font-size:18px;
                    font-weight:700;
                    color:#ffffff;
                  ">
                    {{propertyTitle}}
                  </p>

                  <p style="
                    margin:10px 0 0;
                    font-size:13px;
                    color:#9ca3af;
                  ">
                    Property ID: #{{propertyId}}
                  </p>

                  <p style="
                    margin:8px 0 0;
                    font-size:13px;
                    color:#9ca3af;
                  ">
                    Status:
                    <span style="
                      color:#22c55e;
                      font-weight:700;
                    ">
                      APPROVED
                    </span>
                  </p>

                </td>
              </tr>

            </table>

          </td>
        </tr>

        <tr>
          <td style="padding:10px 40px 25px;">

            <table width="100%" cellpadding="0" cellspacing="0" style="
              background:#172033;
              border-radius:12px;
            ">

              <tr>
                <td align="center" style="padding:20px;">

                  <p style="
                    margin:0;
                    font-size:14px;
                    font-weight:700;
                    color:#e5e7eb;
                  ">
                    Your listing is now published
                  </p>

                  <p style="
                    margin:10px 0 0;
                    font-size:13px;
                    line-height:20px;
                    color:#9ca3af;
                  ">
                    Rentora users can now discover your property through
                    search and property listings.
                  </p>

                </td>
              </tr>

            </table>

          </td>
        </tr>

        <tr>
          <td align="center" style="
            padding:25px;
            border-top:1px solid #1f2937;
          ">

            <p style="
              margin:0;
              font-size:12px;
              color:#64748b;
            ">
              If you did not expect this notification or need assistance,
              please contact Rentora support.
            </p>

          </td>
        </tr>

        <tr>
          <td align="center" style="
            padding:20px;
            background:#0f172a;
          ">

            <p style="
              margin:0;
              font-size:12px;
              color:#64748b;
            ">
              © {{year}} Rentora
            </p>

            <p style="
              margin:8px 0 0;
              font-size:11px;
              color:#475569;
            ">
              Find • Buy • Rent Real Estate
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>