{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/rentora/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/rentora/tsconfig.app.json"
  },
  "projects": {
    "admin": {
      "type": "application",
      "root": "apps/admin",
      "entryFile": "main",
      "sourceRoot": "apps/admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/admin"
          }
        ]
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "common-rentora": {
      "type": "library",
      "root": "libs/common-rentora",
      "entryFile": "index",
      "sourceRoot": "libs/common-rentora/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common-rentora/tsconfig.lib.json"
      }
    },
    "rentora": {
      "type": "application",
      "root": "apps/rentora",
      "entryFile": "main",
      "sourceRoot": "apps/rentora/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rentora/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/rentora"
          }
        ]
      }
    }
  },
  "monorepo": true,
  "root": "apps/rentora"
}